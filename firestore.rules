rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validTransaction() {
      return request.resource.data.keys().hasOnly([
        'type', 'amount', 'category', 'note', 'reason',
        'selectedDate', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.type in ['income', 'expense']
      && request.resource.data.amount is number
      && request.resource.data.amount > 0
      && request.resource.data.amount <= 1000000000
      && validText(request.resource.data.category, 40)
      && request.resource.data.category.size() > 0
      && validText(request.resource.data.note, 120)
      && validText(request.resource.data.reason, 40)
      && validText(request.resource.data.selectedDate, 10)
      && request.resource.data.createdAt is number;
    }

    function validSecuritySettings() {
      return request.resource.data.keys().hasOnly([
        'privacyMode', 'pinHash', 'pinSalt', 'pinAlgorithm',
        'pinUpdatedAt', 'failedPinAttempts', 'pinLockedUntil',
        'lastFailedPinAt'
      ])
      && (!('privacyMode' in request.resource.data) || request.resource.data.privacyMode is bool)
      && (!('pinHash' in request.resource.data) || validText(request.resource.data.pinHash, 200))
      && (!('pinSalt' in request.resource.data) || validText(request.resource.data.pinSalt, 100))
      && (!('pinAlgorithm' in request.resource.data) || validText(request.resource.data.pinAlgorithm, 40))
      && (!('pinUpdatedAt' in request.resource.data) || request.resource.data.pinUpdatedAt is number)
      && (!('failedPinAttempts' in request.resource.data)
          || (request.resource.data.failedPinAttempts is int
              && request.resource.data.failedPinAttempts >= 0
              && request.resource.data.failedPinAttempts <= 5))
      && (!('pinLockedUntil' in request.resource.data) || request.resource.data.pinLockedUntil is number)
      && (!('lastFailedPinAt' in request.resource.data) || request.resource.data.lastFailedPinAt is number)
      && !('pin' in request.resource.data);
    }

    function validBudgetSettings() {
      return request.resource.data.keys().hasOnly(['monthlyLimit'])
      && request.resource.data.monthlyLimit is number
      && request.resource.data.monthlyLimit > 0
      && request.resource.data.monthlyLimit <= 1000000000;
    }

    function validProfileSettings() {
      return request.resource.data.keys().hasOnly([
        'fullName', 'birthDate', 'gender',
        'profileImageUri', 'profileImageBase64', 'updatedAt'
      ])
      && (!('fullName' in request.resource.data) || validText(request.resource.data.fullName, 50))
      && (!('birthDate' in request.resource.data) || validText(request.resource.data.birthDate, 10))
      && (!('gender' in request.resource.data)
          || request.resource.data.gender in ['', 'Perempuan', 'Laki-laki', 'Lainnya'])
      && (!('profileImageUri' in request.resource.data) || validText(request.resource.data.profileImageUri, 500))
      && (!('profileImageBase64' in request.resource.data) || validText(request.resource.data.profileImageBase64, 900000))
      && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number);
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validTransaction();
    }

    match /users/{userId}/settings/security {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validSecuritySettings();
      allow delete: if false;
    }

    match /users/{userId}/settings/budget {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validBudgetSettings();
      allow delete: if false;
    }

    match /users/{userId}/settings/profile {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validProfileSettings();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
